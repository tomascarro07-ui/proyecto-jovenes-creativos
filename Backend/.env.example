# Copiá este archivo como ".env" (en la carpeta Backend) y completá los valores.
# El archivo .env NUNCA se sube a GitHub. En Vercel estas variables se cargan
# en: Project > Settings > Environment Variables.

# Dirección de conexión a MongoDB (en Atlas: Connect > Drivers).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENIA@TU-CLUSTER.mongodb.net/nombre_de_la_base

# Clave para firmar las sesiones. Mínimo 32 caracteres, larga y aleatoria.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dominios desde donde se abre el frontend, separados por coma, SIN "/" al final.
# Local (Live Server) + sitio publicado:
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://TU-FRONTEND.vercel.app

# Solo en tu PC (npm run dev). Vercel define el puerto solo.
PORT=3000

# Solo para el script "npm run admin" (crea el usuario administrador).
ADMIN_EMAIL=
ADMIN_PASSWORD=
